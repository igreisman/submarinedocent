.DS_Store
*\ copy
__pycache__/
*.pyc
.venv/
build/
certs/
serve_https.py
.env.local
feedback.jsonl
corpora/faq_uploads/
bin/anthropic key
web/video-config.local.js

# Personal Claude Code settings (may contain secrets)
.claude/settings.local.json

# Local-only scratch corpora (CONTENT_ROOT for local dev; never commit)
corpora_local/

# Generated NotebookLM corpus exports (kept local)
notebooklm_export/

# Incident/data-recovery snapshots (local only)
backups/

# Local media archive — hundreds of MB of source video, never for the repo
archives/

# Runtime output, not source
uvicorn.log
nohup.out

# Scratch note left over from the patrol import
instructions.txt

# Dead top-level export.  The app reads corpora/eternal_patrol.jsonl via
# CORPORA_DIR; this copy is unreferenced and had already drifted from it.
/eternal_patrol.jsonl

# Generated by bin/pdf_to_html.py from bin/pampanito.pdf
bin/output/

# Unpublished pending permission from the Maritime Association.  Deployed by
# uploading to /data/web/ on Render, which survives redeploys; see the
# Unpublished Pages section of the README.
web/pampanito.html

# Review artefacts from scripts/compare_gate.py and scripts/propose_video_links.py
gate_comparison*.csv
video_link_candidates*.csv

# LibreOffice lock files and working spreadsheets
.~lock.*#
SubmarineDocent_*.xlsx

# Video source assets live outside the repo, at
# ~/Documents/submarinedocent-assets/videos/. Pixelmator sources, spreadsheets
# and mp4s -- build material with no reader in this codebase, and serving them
# from web/ published them by accident. Supersedes the old web/videos/*.mp4
# rule, which covered only the renders and left 807 MB of sources tracked.
web/videos/

# ── B4: gaps found 2026-09-18 ────────────────────────────────────────────────
# .env itself was never ignored -- only .env.local was. A real .env holds the
# admin password, Groq key and SMTP credentials.
.env
.env.*
!.env.example

# The old rule was "*\ copy", which matches a name ENDING in " copy" and so
# misses what Finder actually produces: "foo copy.jsonl", "foo copy 2.jsonl".
* copy*
*\ copy\ [0-9]*

# Artefacts pulled off the production /data disk to the repo root. Anchored with
# a leading slash so the legitimate corpora/ files of the same name are
# unaffected.
/dieselsubs_faq_corpus.jsonl
/ask_log.jsonl
/feedback.jsonl
/videos.jsonl
/museums.jsonl
/incidents.jsonl

# Internal editorial notes, not published
videos_heldback.txt
_test/AI_CONTEXT.md
