# Core app services
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Admin and preview auth
ADMIN_USERNAME=
ADMIN_PASSWORD=
MUSEUM_ADMIN_USERNAME=
MUSEUM_ADMIN_PASSWORD=

# Host-based routing
LEGACY_DOMAIN_HOSTS=submarinedocent.com,www.submarinedocent.com
LEGACY_DOMAIN_TARGET=https://submarinedocent.org
DEFAULT_ROOT_REDIRECT=/web/welcome.html
RETURNING_VISITOR_REDIRECT=/web/faqs.html

# Content source
SAMPLE_CONTENT_MODE=false
CONTENT_ROOT=
# If CONTENT_ROOT is unset and the default corpora are unavailable,
# the app will automatically fall back to sample_data/corpora when present.

# Local HTTPS startup helpers
LOCAL_HTTPS_HOST=localhost
LOCAL_HTTPS_PORT=8443
LOCAL_STATIC_PORT=8444
SSL_KEYFILE=certs/key.pem
SSL_CERTFILE=certs/cert.pem

# ── Admin auth throttling ────────────────────────────────────────────────────
# Failed sign-ins per address before /admin/* returns 429, and the window in
# seconds. Failures are counted, not requests: a correct password clears the
# address's streak.
ADMIN_AUTH_FAIL_LIMIT=5
ADMIN_AUTH_FAIL_WINDOW_SECONDS=900

# Backstop across every address at once. Per-address limiting assumes the key
# cannot be chosen by the caller; this caps the whole surface even if that
# assumption fails. Not cleared by a successful sign-in.
ADMIN_AUTH_GLOBAL_LIMIT=50

# How the limiter identifies a caller. NEVER the leftmost X-Forwarded-For entry:
# proxies append, so the leftmost value is whatever the client sent, and keying
# on it gives an attacker a fresh bucket per request.
#
# PRODUCTION SETTING: TRUSTED_PROXY_HOPS=1
#   DNS is at Namecheap with an A record direct to Render, so exactly one
#   trusted proxy sits in front and the rightmost X-Forwarded-For entry is the
#   caller. Raise this only if another proxy is added in front of Render.
TRUSTED_PROXY_HOPS=1

# Dedicated client-IP header, tried before X-Forwarded-For. UNUSED IN THIS
# DEPLOYMENT -- there is no CDN in front, so nothing sets CF-Connecting-IP and
# the X-Forwarded-For path above is what runs. Kept so that adding a CDN later
# is a configuration change, not a code change.
CLIENT_IP_HEADER=cf-connecting-ip

# ── Contact form ─────────────────────────────────────────────────────────────
# Where the contact form delivers. No default on purpose: an address baked into
# the source would mean a fork silently mails this project's owner. Unset, the
# form logs the message instead of sending it.
HISTORIAN_EMAIL=

# ── Answer generation ────────────────────────────────────────────────────────
# Use an LLM to compose answers instead of the extractive synthesiser.
USE_LLM=false
# Characters per OpenAI text-to-speech request.
OPENAI_TTS_CHAR_LIMIT=320

# ── Retrieval tuning ─────────────────────────────────────────────────────────
# Corpus weights in the BM25 scorer. Tour is 3.0 and FAQ 1.2, both fixed in
# code; these two are the reference corpora, weighted below the museum's own
# material so they supplement rather than displace it.
FLEETSUB_MANUAL_WEIGHT=0.5
SUB_LOSSES_WEIGHT=0.5
# Multiplier when a question matches an FAQ title word for word.
EXACT_TITLE_BOOST=20.0

# ── Content gates ────────────────────────────────────────────────────────────
# Answer from generated drafts (der_/pam_/fix_) as well as accepted faq_ chunks.
# Off by default: drafts are unreviewed. Set to 1 only to deploy the gate
# behaviour-neutrally before reviewing what it displaces.
INCLUDE_GENERATED_FAQS=

# Treat a video with no recorded rights_status as NOT cleared. Fails closed.
RIGHTS_STRICT=

# ── Local HTTPS dev server (start_https.sh, not read by api/) ────────────────
# Host and ports shown in the startup banner and bound by uvicorn, plus the TLS
# material. Generate your own certificates; certs/ is not tracked.
